<?xml version="1.0" encoding="utf-8"?>
<!-- Quick key bar above the keyboard: surface with a hairline on top -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/aideplus_outline_variant_dark" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/aideplus_surface_container_dark" />
        </shape>
    </item>
</layer-list>
